# Carpool Mobility Platform — backend environment template
#
# CMP-DOC-09 BE-015: environment-specific values shall not appear in source.
# CMP-DOC-13 SADR-14 / CMP-DOC-19 OPS-098: a secret is injected at deploy time and
# shall never appear in an artefact, a repository or a build log. This file carries
# names and non-secret defaults only — never a value.
#
# This inventory grows with the implementation. A variable is listed here on the
# commit that first reads it.

# ── Application ──────────────────────────────────────────────────────────────
# The brand name is undecided (BAD-DEC-023). APP_NAME carries the project name,
# not a brand, and no user-facing surface reads it.
APP_NAME="Carpool Mobility Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# DB-001: one MySQL instance and one schema.
# DB-009 / DADR-02: InnoDB. DB-010: full-range Unicode, deterministic collation.
# OPS-024: the deployed server must enforce CHECK constraints.
# DADR-09 requires three accounts (application, evidential writer, read). They are
# introduced with CMP-IMP-047; only the application account exists today.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmp
DB_USERNAME=cmp_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_MIGRATION_USERNAME=cmp_migration
DB_MIGRATION_PASSWORD=
DB_READ_USERNAME=cmp_read
DB_READ_PASSWORD=

# Used only by db:provision-accounts, never at runtime (DB-122 ‡).
DB_PROVISIONING_USERNAME=root
DB_PROVISIONING_PASSWORD=

# ── Session, cache and queue ─────────────────────────────────────────────────
# BADR-07: database-backed queues with named job families. mch_jobs and
# mch_failed_jobs exist (CMP-IMP-027), so the queue runs on the database.
# Session and cache still use file: no mch_ table backs either yet, and
# creating an undocumented one would breach DB-002.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=database

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────────────
# No email provider is selected. The adapter cannot be built until one is
# (readiness analysis §25 action 11); the log mailer keeps the framework bootable.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ── Evidential chain ─────────────────────────────────────────────────
# SEC-106 ‡: held outside the database and not readable through a database
# connection. SEC-172 ‡: escrowed — losing it makes the evidential guarantee
# unverifiable. At least 32 bytes, from a cryptographically secure source.
EVIDENTIAL_CHAIN_KEY=
